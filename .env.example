APP_NAME=architect-career-ai-platform
APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8090

LOG_LEVEL=INFO
LOG_JSON=true

CORS_ALLOW_ORIGINS=*
RATE_LIMIT_REQUESTS_PER_MINUTE=120

AUTH_JWT_ENABLED=false
AUTH_JWT_SECRET=change-me
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_AUDIENCE=
AUTH_JWT_ISSUER=
AUTH_API_KEY_ENABLED=false
AUTH_API_KEYS=
AUTH_INTERNAL_SERVICE_HEADER=X-Internal-Service
AUTH_INTERNAL_SERVICE_TOKENS=

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_ENABLED=true

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_ENABLED=false

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_ENABLED=false

LLM_PROVIDER=openai

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

OTEL_ENABLED=true
OTEL_SERVICE_NAME=architect-career-ai-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_SAMPLER_ARG=1.0

METRICS_ENABLED=true

# Knowledge / Enterprise RAG
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=64
AZURE_EMBEDDING_DEPLOYMENT=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
BGE_M3_MODEL=BAAI/bge-m3
SENTENCE_TRANSFORMERS_MODEL=sentence-transformers/all-MiniLM-L6-v2

VECTOR_STORE_PROVIDER=memory
QDRANT_COLLECTION=acos_knowledge

CHUNKING_STRATEGY=recursive
CHUNK_SIZE=800
CHUNK_OVERLAP=120

RETRIEVAL_MODE=dense
RETRIEVAL_SCORE_THRESHOLD=
SUMMARIZE_TOP_K=5
SUMMARIZE_MAX_LENGTH=800
SUMMARIZE_PROMPT_VERSION=v1
CONTEXT_MAX_TOKENS=3000
PROMPTS_ROOT=prompts/knowledge

RERANKER_PROVIDER=identity
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-english-v3.0

# Agentic AI
AGENTIC_PROMPTS_ROOT=prompts/agentic
AGENTIC_DEFAULT_WORKFLOW=question_answering
